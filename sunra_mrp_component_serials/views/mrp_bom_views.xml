<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Herencia del formulario de la LdM: opt-in del traslado automatico (D17) -->
    <record id="mrp_bom_form_view" model="ir.ui.view">
        <field name="name">mrp.bom.form.inherit.sunra_mrp_component_serials</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='miscellaneous']//field[@name='consumption']" position="after">
                <field name="sunra_pull_kit_components"/>
            </xpath>
        </field>
    </record>
</odoo>
