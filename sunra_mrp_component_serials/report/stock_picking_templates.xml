<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Herencia del thead del remito: encabezados Motor / Batteries / Controller -->
    <template id="report_delivery_document" inherit_id="stock.report_delivery_document">
        <xpath expr="//th[@name='lot_serial']" position="after">
            <th class="text-end" t-if="has_serial_number">Motor</th>
            <th class="text-end" t-if="has_serial_number">Batteries</th>
            <th class="text-end" t-if="has_serial_number">Controller</th>
        </xpath>
    </template>

    <!-- Herencia de la fila de movimiento: valores de Motor / Batteries / Controller -->
    <template id="stock_report_delivery_has_serial_move_line" inherit_id="stock.stock_report_delivery_has_serial_move_line">
        <xpath expr="//t[@name='move_line_lot']" position="after">
            <t t-if="has_serial_number">
                <t t-set="sunra_component_values" t-value="move_line.lot_id._sunra_component_report_values()"/>
                <td class="text-end"><span t-esc="sunra_component_values['motor_name']"/></td>
                <td class="text-end"><span t-esc="sunra_component_values['battery_names']"/></td>
                <td class="text-end"><span t-esc="sunra_component_values['controller_name']"/></td>
            </t>
        </xpath>
    </template>
</odoo>
