<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ficha del producto: recuadro de precio por medio de pago (D17/D25). Contrato de locators
         por `name` (D21): `div[@name='wspmp_box']` y el slot `div[@name='wspmp_installments']`.
         Cuatro operaciones, en este orden (el `move` no puede ir anidado dentro del markup nuevo,
         T02): (a) arma el recuadro como ultimo hijo de `div[@name='product_price']` (con
         `priority="18"` se aplica despues de `l10n_ar_website_sale`, que agrega el `<small>` de
         impuestos nacionales con la prioridad por defecto, D18); (b) mueve el contenedor del
         precio del core (`product_price_container`, con el precio actual y el de lista) DENTRO del
         recuadro, sin duplicarlo (D19), **antes** del slot de cuotas: asi el orden en el DOM queda
         precios -> contenedor -> slot incluso cuando el recuadro esta "display: contents" (sin
         reglas visibles, CA19) y `order: -1` no puede reordenar nada; (c) y (d) envuelven cada
         precio del core en su propio renglon (`div.o_wspmp_line`) junto al pill que le corresponde
         — el del descuento que ya publica el core arriba (lista de precios / comparativo) y el del
         medio de pago abajo (D25, maqueta aprobada el 14-09-2026). Los dos envoltorios van
         DESPUES del `move` a proposito: asi los nodos quedan detras del `t-set` del recuadro y las
         variables (`wspmp_prices`, `wspmp_ref_badge`) ya estan en contexto al renderizar.
         El JS de variantes (payment_method_price.js) repinta `.o_wspmp_prices` y togglea las
         clases y el texto de los dos pills al cambiar de variante. -->
    <template
        id="product_price"
        inherit_id="website_sale.product_price"
        name="Product price - payment method box"
        priority="18"
    >
        <xpath expr="//div[@name='product_price']" position="inside">
            <t t-set="wspmp_prices" t-value="combination_info.get('payment_method_prices') or []"/>
            <t t-set="wspmp_ref_badge" t-value="combination_info.get('payment_method_reference_badge')"/>
            <div
                name="wspmp_box"
                t-attf-class="o_wspmp_box #{'o_wspmp_box_active' if wspmp_prices else ''} #{'o_wspmp_discounted' if wspmp_prices and wspmp_prices[0]['price_type'] == 'discount' else ''}"
            >
                <div class="o_wspmp_prices">
                    <t t-foreach="wspmp_prices" t-as="pm_price">
                        <div class="o_wspmp_price">
                            <span class="o_wspmp_price_amount" t-out="pm_price['price_formatted']"/>
                            <!-- "Ahorras $X" (D25). Siempre en el DOM, como los pills: el JS solo
                                 togglea texto y visibilidad al cambiar de variante. -->
                            <span
                                t-attf-class="o_wspmp_saving #{'' if pm_price['saving_label'] else 'd-none'}"
                                t-out="pm_price['saving_label'] or ''"
                            />
                            <span class="o_wspmp_price_label">
                                <t t-out="pm_price['label']"/>
                                <b t-out="pm_price['name']"/>
                            </span>
                        </div>
                    </t>
                </div>
                <div name="wspmp_installments" class="o_wspmp_installments"/>
            </div>
        </xpath>
        <xpath expr="//div[@name='wspmp_installments']" position="before">
            <xpath expr="//div[@name='product_price_container']" position="move"/>
        </xpath>
        <xpath expr="//span[@name='product_list_price']" position="replace">
            <!-- `$0` tiene que ser el PRIMER nodo de texto del envoltorio, literal: la herencia
                 lo busca con `.//*[text()='$0']` (template_inheritance.py:163), asi que cualquier
                 salto de linea antes lo deja sin matchear y el `$0` sale impreso en la pagina.
                 El nodo original se *anexa al final*, con lo cual el pill queda primero en el DOM
                 y el orden visual lo pone el SCSS (`order`). -->
            <div class="o_wspmp_line o_wspmp_line_ref">$0<span
                    t-attf-class="o_wspmp_badge o_wspmp_badge_ref #{'' if wspmp_ref_badge else 'd-none'}"
                    t-out="wspmp_ref_badge or ''"
                /></div>
        </xpath>
        <xpath expr="//del[@name='product_price_strikethrough']" position="replace">
            <!-- El precio comparativo ("Precio comparativo" de la ficha del producto) es el OTRO
                 nodo tachado posible de la ficha, excluyente con el de arriba: el core solo lo
                 arma cuando NO hay descuento de lista de precios
                 (`website_sale/models/product_template.py:630`). Por eso los dos envoltorios
                 pueden pintar el mismo pill sin duplicarlo: como mucho uno de los dos tiene
                 contenido, y el SCSS esconde el que quedo vacio. -->
            <div class="o_wspmp_line o_wspmp_line_cmp">$0<span
                    t-attf-class="o_wspmp_badge o_wspmp_badge_ref #{'' if wspmp_ref_badge else 'd-none'}"
                    t-out="wspmp_ref_badge or ''"
                /></div>
        </xpath>
        <xpath expr="//span[hasclass('oe_price')]" position="replace">
            <div class="o_wspmp_line o_wspmp_line_current">$0<span
                    t-attf-class="o_wspmp_badge o_wspmp_badge_pm #{'' if wspmp_prices and wspmp_prices[0]['badge'] else 'd-none'}"
                    t-out="wspmp_prices[0]['badge'] if wspmp_prices and wspmp_prices[0]['badge'] else ''"
                /></div>
        </xpath>
    </template>

    <!-- Grilla del shop: mismo recuadro en la tarjeta. Cinco operaciones (T03), en este orden:
         (a) arma el recuadro dentro de `div.product_price` (clase estatica del core, `hasclass`
         vale aca); (b) y (c) mueven, cada uno por separado y vacio, **antes** del slot de cuotas
         (mismo motivo que en la ficha: el orden en el DOM no puede depender de `order: -1`, que no
         aplica con el recuadro en `display: contents`), primero el precio de lista tachado
         (`t[name='product_base_price']`) y despues el precio actual (`span.fw-bold`, el
         `price_reduce` del core), de modo que el tachado quede arriba; (d) y (e) envuelven cada
         uno en su renglon con su pill (D25). Los `move` van ANTES de los envoltorios: los nodos
         tienen que quedar detras del `t-set` del recuadro para que las variables esten en
         contexto. El recuadro NO hereda el layout de `.product_price` (que no tiene fallback en la
         custom property de display del core): fija el suyo en el SCSS. -->
    <template
        id="products_item"
        inherit_id="website_sale.products_item"
        name="Product tile - payment method box"
        priority="18"
    >
        <xpath expr="//div[hasclass('product_price')]" position="inside">
            <t t-set="wspmp_prices" t-value="template_price_vals.get('payment_method_prices') or []"/>
            <t t-set="wspmp_ref_badge" t-value="template_price_vals.get('payment_method_reference_badge')"/>
            <div
                name="wspmp_box"
                t-attf-class="o_wspmp_box o_wspmp_box_tile #{'o_wspmp_box_active' if wspmp_prices else ''} #{'o_wspmp_discounted' if wspmp_prices and wspmp_prices[0]['price_type'] == 'discount' else ''}"
            >
                <div class="o_wspmp_prices">
                    <t t-foreach="wspmp_prices" t-as="pm_price">
                        <div class="o_wspmp_price">
                            <span class="o_wspmp_price_amount" t-out="pm_price['price_formatted']"/>
                            <span
                                t-attf-class="o_wspmp_saving #{'' if pm_price['saving_label'] else 'd-none'}"
                                t-out="pm_price['saving_label'] or ''"
                            />
                            <span class="o_wspmp_price_label">
                                <t t-out="pm_price['label']"/>
                                <b t-out="pm_price['name']"/>
                            </span>
                        </div>
                    </t>
                </div>
                <div name="wspmp_installments" class="o_wspmp_installments"/>
            </div>
        </xpath>
        <xpath expr="//div[@name='wspmp_installments']" position="before">
            <xpath expr="//t[@name='product_base_price']" position="move"/>
        </xpath>
        <xpath expr="//div[@name='wspmp_installments']" position="before">
            <!-- `aria-label` es un atributo traducible (TRANSLATED_ATTRS, odoo/tools/translate.py):
                 la herencia de vistas lo rechaza como selector ("View inheritance may not use
                 attribute 'aria-label' as a selector", ir_ui_view.py:412) y aborta la carga con
                 ParseError. El span no tiene `name`, pero si clase propia (`fw-bold`, ademas de
                 `mb-0`): unica dentro de `div.product_price` en el arch combinado. Por la misma
                 razon los selectores CSS/JS van por esta clase y nunca por `aria-label`: en
                 render el atributo sale traducido (`aria-label="Precio de venta"` en es_AR), asi
                 que un selector CSS por el string en ingles simplemente no matchea (sin error). -->
            <xpath expr="//div[hasclass('product_price')]//span[hasclass('fw-bold')]" position="move"/>
        </xpath>
        <xpath expr="//t[@name='product_base_price']" position="replace">
            <!-- El `t-if` del core viaja DENTRO del `$0`: cuando no hay precio de lista que tachar
                 el renglon queda sin `<del>`, y el SCSS lo esconde (`:not(:has(del))`) para no
                 dejar un renglon vacio con solo el pill. -->
            <div class="o_wspmp_line o_wspmp_line_cmp">$0<span class="o_wspmp_badge o_wspmp_badge_ref"
                      t-if="wspmp_ref_badge" t-out="wspmp_ref_badge"/></div>
        </xpath>
        <xpath expr="//div[hasclass('product_price')]//span[hasclass('fw-bold')]" position="replace">
            <div class="o_wspmp_line o_wspmp_line_current">$0<span
                    t-attf-class="o_wspmp_badge o_wspmp_badge_pm #{'' if wspmp_prices and wspmp_prices[0]['badge'] else 'd-none'}"
                    t-out="wspmp_prices[0]['badge'] if wspmp_prices and wspmp_prices[0]['badge'] else ''"
                /></div>
        </xpath>
    </template>

    <!-- Carrito y checkout: fila por medio debajo del Total, con la etiqueta nueva y un pill por
         fila (sin recuadro ni slot de cuotas, D23). -->
    <template
        id="total"
        inherit_id="website_sale.total"
        name="Cart total - payment method totals"
    >
        <xpath expr="//tr[@name='o_order_total']" position="after">
            <t
                t-set="wspmp_totals"
                t-value="website_sale_order._get_payment_method_price_totals()"
            />
            <tr t-foreach="wspmp_totals" t-as="pm_total" name="o_order_total_payment_method">
                <td class="ps-0 pt-0 pb-0 border-0 text-muted o_wspmp_price_label" colspan="2">
                    <t t-out="pm_total['label']"/>
                    <b t-out="pm_total['name']"/>
                    <span t-if="pm_total['badge']" class="o_wspmp_badge o_wspmp_badge_inline" t-out="pm_total['badge']"/>
                </td>
                <td class="text-end pe-0 pt-0 pb-0 border-0 o_wspmp_price_amount">
                    <t t-out="pm_total['price_formatted']"/>
                </td>
            </tr>
        </xpath>
    </template>
</odoo>
