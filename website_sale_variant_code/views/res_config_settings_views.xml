<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Toggle por sitio del ocultamiento de la descripcion en el carrito. Va junto a los ajustes
         de carrito del eCommerce porque es lo que afecta. -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website_sale_variant_code</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="cart_redirect_setting" position="after">
                <setting
                    id="hide_cart_line_description_setting"
                    string="Hide Sales Description in Cart"
                    help="The internal reference is already shown on each cart line. Hide the sales description to avoid showing the code twice."
                >
                    <field name="hide_cart_line_description"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
