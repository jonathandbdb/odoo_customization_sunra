<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Toggle por sitio del selector de cantidad en el listado. Va junto a los ajustes de carrito
         del eCommerce porque es lo que afecta. -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website_sale_grid_quantity</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="cart_redirect_setting" position="after">
                <setting
                    id="show_grid_quantity_setting"
                    string="Quantity Selector in Product List"
                    help="Let customers choose how many units to add straight from the product list, without opening each product."
                >
                    <field name="show_grid_quantity"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
