#. module: website_sale_grid_quantity
#: model:ir.model.fields,field_description:website_sale_grid_quantity.field_res_config_settings__show_grid_quantity
#: model:ir.model.fields,field_description:website_sale_grid_quantity.field_website__show_grid_quantity
#: model_terms:ir.ui.view,arch_db:website_sale_grid_quantity.res_config_settings_view_form
msgid "Quantity Selector in Product List"
msgstr "Selector de cantidad en el listado de productos"

#. module: website_sale_grid_quantity
#: model:ir.model.fields,help:website_sale_grid_quantity.field_res_config_settings__show_grid_quantity
#: model:ir.model.fields,help:website_sale_grid_quantity.field_website__show_grid_quantity
msgid "Show a quantity selector with plus and minus buttons on every product card of the shop, so customers can choose how many units to add without opening the product page. Useful for spare parts catalogs, where an order is made of many different items."
msgstr "Muestra un selector de cantidad con botones de más y menos en cada tarjeta de la tienda, para que el cliente elija cuántas unidades agregar sin entrar a la ficha del producto. Útil en catálogos de repuestos, donde un pedido son muchos artículos distintos."

#. module: website_sale_grid_quantity
#: model_terms:ir.ui.view,arch_db:website_sale_grid_quantity.res_config_settings_view_form
msgid "Let customers choose how many units to add straight from the product list, without opening each product."
msgstr "Permite elegir cuántas unidades agregar directamente desde el listado, sin entrar a cada producto."

#. module: website_sale_grid_quantity
#: model_terms:ir.ui.view,arch_db:website_sale_grid_quantity.shop_product_buttons
msgid "Add one"
msgstr "Agregar uno"

#. module: website_sale_grid_quantity
#: model_terms:ir.ui.view,arch_db:website_sale_grid_quantity.shop_product_buttons
msgid "Remove one"
msgstr "Quitar uno"
