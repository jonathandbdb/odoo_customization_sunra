<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Interruptor por sitio de la leyenda de cuotas, en los ajustes de eCommerce. El formulario
         de ajustes de Sitio Web ya trae el selector de website arriba, asi que el valor se guarda
         contra el sitio elegido. Se ancla despues de `cart_redirect_setting`, el mismo ancla que
         usan los modulos hermanos del repo. -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website_sale_installment_plans_ux</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="cart_redirect_setting" position="after">
                <setting
                    id="show_installment_plans_setting"
                    string="Installment Plans"
                    help="Publish the installment legend below the product price, in the shop list and on the product page. The plans are configured per card in Accounting; only the ones of this website's company are shown."
                >
                    <field name="show_installment_plans"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
