<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Niveles del semaforo. Se editan desde los ajustes de Sitio Web (lista embebida), estas
         vistas son las que usa esa lista y el acceso directo al modelo. -->
    <record id="website_stock_level_view_list" model="ir.ui.view">
        <field name="name">website.stock.level.view.list</field>
        <field name="model">website.stock.level</field>
        <field name="arch" type="xml">
            <list string="Stock Levels" editable="bottom">
                <field name="min_qty"/>
                <field name="name"/>
                <field name="color"/>
                <field name="color_custom" optional="hide"/>
                <field name="website_id" column_invisible="context.get('hide_website')"/>
            </list>
        </field>
    </record>

    <record id="website_stock_level_view_form" model="ir.ui.view">
        <field name="name">website.stock.level.view.form</field>
        <field name="model">website.stock.level</field>
        <field name="arch" type="xml">
            <form string="Stock Level">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="min_qty"/>
                        </group>
                        <group>
                            <field name="color"/>
                            <field name="color_custom"/>
                            <field name="website_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="website_stock_level_action" model="ir.actions.act_window">
        <field name="name">Stock Levels</field>
        <field name="res_model">website.stock.level</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
