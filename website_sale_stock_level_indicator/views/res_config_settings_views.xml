<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Semaforo de stock: el toggle y los niveles del sitio, en los ajustes de eCommerce. La
         lista embebida se muestra solo con el semaforo prendido para no ocupar espacio en los
         sitios que no lo usan. -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website_sale_stock_level_indicator</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="cart_redirect_setting" position="after">
                <setting
                    id="show_stock_level_setting"
                    string="Stock Level Indicator"
                    help="Show a label with the stock level of each product. Configure one line per level: the quantity it starts at, the text and the color."
                >
                    <field name="show_stock_level"/>
                    <div class="mt-2" invisible="not show_stock_level">
                        <field
                            name="stock_level_ids"
                            nolabel="1"
                            context="{'hide_website': True, 'default_website_id': website_id}"
                        />
                    </div>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
