#. module: website_sale_stock_level_indicator
#: model:ir.model,name:website_sale_stock_level_indicator.model_website_stock_level
msgid "Website Stock Level"
msgstr "Nivel de stock del sitio web"

#. module: website_sale_stock_level_indicator
#: model:ir.model.fields,field_description:website_sale_stock_level_indicator.field_res_config_settings__show_stock_level
#: model:ir.model.fields,field_description:website_sale_stock_level_indicator.field_website__show_stock_level
#: model_terms:ir.ui.view,arch_db:website_sale_stock_level_indicator.res_config_settings_view_form
msgid "Stock Level Indicator"
msgstr "Indicador de nivel de stock"

#. module: website_sale_stock_level_indicator
#: model:ir.model.fields,help:website_sale_stock_level_indicator.field_res_config_settings__show_stock_level
#: model:ir.model.fields,help:website_sale_stock_level_indicator.field_website__show_stock_level
msgid "Show a label with the stock level of each product (out of stock, low stock, normal stock...) in the shop list and on the product page. The levels are configured below, one per website."
msgstr "Muestra un cartel con el nivel de stock de cada producto (sin stock, poco stock, stock normal...) en el listado de la tienda y en la ficha. Los niveles se configuran abajo, por sitio web."

