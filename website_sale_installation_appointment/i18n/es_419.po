msgid "Change"
msgstr "Cambiar"

#. module: website_sale_installation_appointment
#: model_terms:ir.ui.view,arch_db:website_sale_installation_appointment.installation
msgid "Choose the day and time when our crew will do the installation."
msgstr "Elegí el día y la hora en que nuestro equipo va a hacer la instalación."

#. module: website_sale_installation_appointment
#: model:website.checkout.step,main_button_label:website_sale_installation_appointment.checkout_step_installation
msgid "Continue"
msgstr "Continuar"

#. module: website_sale_installation_appointment
