#. module: website_sale_installation_appointment
#: model_terms:ir.ui.view,arch_db:website_sale_installation_appointment.installation
msgid ""
"<span>Images only. They help the crew know what to expect at the "
"installation site.</span>"
msgstr "<span>Solo imágenes. Le sirven al equipo para saber con qué se va a encontrar en el lugar.</span>"

#. module: website_sale_installation_appointment
#: model:ir.model.fields,help:website_sale_installation_appointment.field_sale_order__installation_event_id
msgid ""
"Appointment created from the installation booking once the order is "
"confirmed."
msgstr "Cita creada a partir de la reserva de instalación cuando se confirma el pedido."

#. module: website_sale_installation_appointment
#: model:website.checkout.step,back_button_label:website_sale_installation_appointment.checkout_step_installation
