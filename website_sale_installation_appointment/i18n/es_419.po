#: model_terms:ir.ui.view,arch_db:website_sale_installation_appointment.installation
msgid ""
"Upload clear, well-lit photos showing your door from the outside,\n"
"                                from the inside, and the door edge (where the lock sits)."
msgstr "Subí fotos claras y bien iluminadas donde se vea tu puerta desde afuera, desde adentro y el canto (el borde donde entra la cerradura)."

#. module: website_sale_installation_appointment
#: model_terms:ir.ui.view,arch_db:website_sale_installation_appointment.installation
msgid "Uploaded so far:"
msgstr "Subidas hasta ahora:"

#. module: website_sale_installation_appointment
#. odoo-javascript
#: code:addons/website_sale_installation_appointment/static/src/js/installation_photos.js:0
msgid "Uploading photos…"
msgstr "Subiendo las fotos…"

#. module: website_sale_installation_appointment
#: model_terms:ir.ui.view,arch_db:website_sale_installation_appointment.installation
msgid "We need these two things before confirming your appointment."
msgstr "Necesitamos estos dos datos antes de confirmar el turno."

#. module: website_sale_installation_appointment
#: model:ir.model.fields.selection,name:website_sale_installation_appointment.selection__appointment_question__answer_format__integer
msgid "Whole number"
msgstr "Número entero"

#. module: website_sale_installation_appointment
#. odoo-python
#: code:addons/website_sale_installation_appointment/controllers/website_sale_installation_appointment.py:0
msgid "You can upload up to %(max_photos)s photos."
msgstr "Podés subir hasta %(max_photos)s fotos."

#. module: website_sale_installation_appointment
#: model_terms:ir.ui.view,arch_db:website_sale_installation_appointment.installation
msgid ""
"You'll need 4 or 8 AA/AAA batteries (depending on your model) on\n"
"                            installation day — without them the device can't be set up."
msgstr "Necesitás tener 4 u 8 pilas AA/AAA (según tu modelo) el día de la instalación — sin ellas no se puede configurar el equipo."

#. module: website_sale_installation_appointment
#: model_terms:ir.ui.view,arch_db:website_sale_installation_appointment.installation
msgid ""
"Your address must be complete (street, number, and floor/apartment if\n"
"                            applicable)."
msgstr "La dirección debe estar completa (calle + altura + piso/depto si corresponde)."

#. module: website_sale_installation_appointment
#. odoo-python
#: code:addons/website_sale_installation_appointment/controllers/website_sale_installation_appointment.py:0
msgid "Your installation is not scheduled yet."
msgstr "Todavía no agendaste la instalación."

#. module: website_sale_installation_appointment
#: model_terms:ir.ui.view,arch_db:website_sale_installation_appointment.installation
msgid "of"
msgstr "de"

#. module: website_sale_installation_appointment
#: model_terms:ir.ui.view,arch_db:website_sale_installation_appointment.installation
msgid ""
"⏳ Installation duration: set aside between 2 and 4 hours (it varies\n"
"                            depending on the complexity of the door)."
msgstr "⏳ Duración de la instalación: reservate entre 2 y 4 horas (varía según la complejidad de la puerta)."
