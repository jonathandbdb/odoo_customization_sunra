#: model:ir.model.fields,help:website_sale_installation_appointment.field_sale_order__installation_photo_ids
msgid ""
"Photos of the installation site uploaded by the customer during the "
"checkout."
msgstr "Fotos del lugar de instalación que subió el cliente durante el checkout."

#. module: website_sale_installation_appointment
#. odoo-python
#: code:addons/website_sale_installation_appointment/models/sale_order.py:0
msgid ""
"Photos of the installation site uploaded by the customer on order %(order)s."
msgstr "Fotos del lugar de instalación cargadas por el cliente en el pedido %(order)s."

#. module: website_sale_installation_appointment
#. odoo-python
#: code:addons/website_sale_installation_appointment/models/sale_order.py:0
msgid "Please schedule the date and time of the installation."
msgstr "Agendá el día y la hora de la instalación."

#. module: website_sale_installation_appointment
#. odoo-python
#: code:addons/website_sale_installation_appointment/models/sale_order.py:0
msgid ""
"Please upload at least %(min_photos)s photo(s) of the installation site "
"(%(missing)s missing)."
msgstr "Subí al menos %(min_photos)s foto(s) del lugar de instalación (faltan %(missing)s)."

#. module: website_sale_installation_appointment
#: model_terms:ir.ui.view,arch_db:website_sale_installation_appointment.installation
