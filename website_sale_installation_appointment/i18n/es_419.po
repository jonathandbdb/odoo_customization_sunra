msgstr "Quitar"

#. module: website_sale_installation_appointment
#: model_terms:ir.ui.view,arch_db:website_sale_installation_appointment.installation
msgid "Schedule the installation<i class=\"fa fa-angle-right ms-2\" role=\"img\"/>"
msgstr "Agendar la instalación<i class=\"fa fa-angle-right ms-2\" role=\"img\"/>"

#. module: website_sale_installation_appointment
#: model_terms:ir.ui.view,arch_db:website_sale_installation_appointment.installation
msgid "Shop - Installation"
msgstr "Tienda - Instalación"

#. module: website_sale_installation_appointment
#. odoo-python
#: code:addons/website_sale_installation_appointment/models/delivery_carrier.py:0
msgid ""
"The appointment type %(appointment_type)s cannot be used for installations: "
"it must have a payment step and a booking product, otherwise the appointment"
" cannot be linked to the eCommerce order."
msgstr "El tipo de cita %(appointment_type)s no se puede usar para instalaciones: necesita paso de pago y un producto de reserva, si no la cita no puede quedar vinculada al pedido del eCommerce."

#. module: website_sale_installation_appointment
#. odoo-python
#: code:addons/website_sale_installation_appointment/controllers/website_sale_installation_appointment.py:0
msgid "The file %(filename)s is not an image."
msgstr "El archivo %(filename)s no es una imagen."

#. module: website_sale_installation_appointment
#. odoo-python
#: code:addons/website_sale_installation_appointment/controllers/website_sale_installation_appointment.py:0
msgid "The file %(filename)s is too big (maximum %(max_size)s MB)."
msgstr "El archivo %(filename)s es demasiado grande (máximo %(max_size)s MB)."

#. module: website_sale_installation_appointment
#. odoo-python
#: code:addons/website_sale_installation_appointment/models/delivery_carrier.py:0
msgid "The minimum amount of installation photos cannot be negative."
msgstr "La cantidad mínima de fotos de instalación no puede ser negativa."

#. module: website_sale_installation_appointment
#. odoo-python
#: code:addons/website_sale_installation_appointment/models/delivery_carrier.py:0
msgid ""
"The product %(product)s of the appointment type %(appointment_type)s must "
"either create a task in a project or have a sales price, otherwise no "
"booking is created when the customer schedules the installation."
msgstr "El producto %(product)s del tipo de cita %(appointment_type)s tiene que crear una tarea en un proyecto o tener precio de venta, si no no se crea la reserva cuando el cliente agenda la instalación."

#. module: website_sale_installation_appointment
#. odoo-python
#: code:addons/website_sale_installation_appointment/controllers/website_sale_installation_appointment.py:0
msgid "You can upload up to %(max_photos)s photos."
msgstr "Podés subir hasta %(max_photos)s fotos."

#. module: website_sale_installation_appointment
#. odoo-python
#: code:addons/website_sale_installation_appointment/controllers/website_sale_installation_appointment.py:0

msgid "Your installation is not scheduled yet."
msgstr "Todavía no agendaste la instalación."
