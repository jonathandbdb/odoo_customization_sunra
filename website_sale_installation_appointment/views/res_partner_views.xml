<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- "Entre calles" (D46): junto a los campos de direccion, para que el backoffice y la
         cuadrilla lo vean en la ficha del contacto. Es un dato del DOMICILIO, no de la venta. -->
    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.website_sale_installation_appointment</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_address_format')]" position="after">
                <field name="between_streets" placeholder="e.g. Peru and Chile"/>
            </xpath>
        </field>
    </record>
</odoo>
