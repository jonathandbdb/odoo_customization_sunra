<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pedido: pestaña con lo que cargo el cliente para la instalacion (cita y fotos del lugar). -->
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.website_sale_installation_appointment</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="before">
                <field name="installation_required" invisible="1"/>
            </field>
            <notebook position="inside">
                <page name="installation" string="Installation" invisible="not installation_required">
                    <group>
                        <group name="installation_appointment">
                            <field name="installation_appointment_type_id"/>
                            <field name="installation_booking_id" invisible="not installation_booking_id"/>
                            <field name="installation_event_id" invisible="not installation_event_id"/>
                        </group>
                    </group>
                    <separator string="Photos of the installation site"/>
                    <field name="installation_photo_ids" widget="many2many_binary" nolabel="1"/>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
