<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formato esperado de la respuesta: sin esto una pregunta de texto acepta cualquier cosa
         (el nativo solo distingue el TIPO de campo, no valida el contenido). -->
    <record id="appointment_question_view_form" model="ir.ui.view">
        <field name="name">appointment.question.view.form.inherit.website_sale_installation_appointment</field>
        <field name="model">appointment.question</field>
        <field name="inherit_id" ref="appointment.appointment_question_view_form"/>
        <field name="arch" type="xml">
            <field name="question_required" position="after">
                <field name="answer_format" invisible="question_type in ('select', 'radio', 'checkbox')"/>
                <field name="installation_measure_guide"/>
            </field>
        </field>
    </record>

    <record id="appointment_question_view_list" model="ir.ui.view">
        <field name="name">appointment.question.view.list.inherit.website_sale_installation_appointment</field>
        <field name="model">appointment.question</field>
        <field name="inherit_id" ref="appointment.appointment_question_view_list"/>
        <field name="arch" type="xml">
            <field name="question_type" position="after">
                <field name="answer_format" optional="show"/>
                <field name="installation_measure_guide" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
