<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Metodo de envio: opt-in de instalacion (tipo de cita + fotos minimas). -->
    <record id="view_delivery_carrier_form" model="ir.ui.view">
        <field name="name">delivery.carrier.view.form.inherit.website_sale_installation_appointment</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <group name="delivery_details" position="inside">
                <field name="installation_appointment_type_id"/>
                <field name="installation_min_photos" invisible="not installation_appointment_type_id"/>
                <field name="includes_free_batteries"/>
            </group>
        </field>
    </record>
</odoo>
