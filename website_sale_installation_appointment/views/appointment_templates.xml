<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Los inputs de las preguntas salen del nativo con type="phone" / type="char", que NO existen
         en HTML: el navegador los trata como texto libre y el cliente puede escribir cualquier cosa
         (era el reclamo de "acepta cualquier numero de telefono o DNI"). Se emiten con el tipo real
         y con inputmode/pattern segun el formato configurado en la pregunta; el formulario nativo
         llama a reportValidity() antes de enviar, asi que el error se ve en el campo. -->
    <template id="appointment_form" inherit_id="appointment.appointment_form">
        <!-- Errores de formato de la validacion del servidor (red de seguridad del pattern). -->
        <xpath expr="//form[hasclass('appointment_submit_form')]" position="before">
            <!-- D57: en el camino del checkout el cliente ya cargo nombre y mail en el paso de
                 Direccion; el formulario de la cita solo tiene que confirmar el turno. Se colapsan
                 los dos campos a inputs ocultos (el submit nativo los sigue necesitando) y se
                 muestra una linea con quien reserva. La condicion exige ademas que los datos esten
                 de verdad: si por lo que sea `partner_data` viene vacio, se cae al formulario
                 nativo en vez de mandar un nombre en blanco. -->
            <t t-set="installation_known_customer"
               t-value="appointment_type._is_installation_checkout_source() and partner_data.get('name') and partner_data.get('email')"/>
            <!-- D59: el formulario del LINK se organiza en secciones numeradas para no leerse
                 como un muro de campos. El del checkout no se toca: ahi solo se confirma el
                 turno y son dos campos. -->
            <t t-set="installation_link_form" t-value="appointment_type._is_installation_link_form()"/>
            <div t-if="installation_answer_errors" class="alert alert-danger" role="alert">
                <div t-foreach="installation_answer_errors" t-as="answer_error"
                     t-key="answer_error_index" t-out="answer_error"/>
            </div>
        </xpath>
        <!-- Fotos del lugar en el formulario de la cita: el JS nativo hace un submit() plano del
             form, asi que con multipart los archivos viajan igual que en el checkout. -->
        <xpath expr="//form[hasclass('appointment_submit_form')]" position="attributes">
            <attribute name="enctype">multipart/form-data</attribute>
            <!-- La clase del form es estatica en el nativo; se agrega por `t-attf-class`, que en el
                 render pisa al `class` (ir_qweb.py:1946), asi que hay que repetir la del core. -->
            <attribute name="t-attf-class">appointment_submit_form #{'o_installation_sections' if installation_link_form else ''}</attribute>
        </xpath>
        <!-- Seccion 1: los datos de contacto (los dos campos nativos). Se ancla en el csrf porque
             las filas de nombre y correo las reemplaza una operacion anterior (D57). -->
        <xpath expr="//input[@name='csrf_token']" position="after">
            <t t-if="installation_link_form"
               t-call="website_sale_installation_appointment.installation_form_section">
                <t t-set="sec_num">1</t>
                <t t-set="sec_title">Your details</t>
                <t t-set="sec_help">So we can get in touch and confirm the visit.</t>
            </t>
        </xpath>
        <!-- Seccion 2: las preguntas del tipo de cita (material de la puerta y las que agreguen). -->
        <xpath expr="//t[@t-foreach='appointment_type.question_ids']" position="before">
            <t t-if="installation_link_form"
               t-call="website_sale_installation_appointment.installation_form_section">
                <t t-set="sec_num">2</t>
                <t t-set="sec_title">About your door</t>
                <t t-set="sec_help">Tell us what the crew is going to find.</t>
            </t>
        </xpath>
        <!-- Nombre y correo: ocultos cuando ya los sabemos (D57). -->
        <xpath expr="//label[@for='name']/.." position="replace">
            <t t-if="installation_known_customer">
                <div class="alert alert-light border mb-4 o_not_editable" role="note">
                    <i class="fa fa-user me-2" role="img"/>
                    <span>You are booking as</span>
                    <b class="ms-1" t-out="partner_data['name']"/>
                    <span class="text-muted ms-1" t-out="partner_data['email']"/>
                </div>
                <input type="hidden" name="name" t-att-value="partner_data['name']"/>
            </t>
            <t t-else="">$0</t>
        </xpath>
        <xpath expr="//label[@for='email']/.." position="replace">
            <t t-if="installation_known_customer">
                <input type="hidden" name="email" t-att-value="partner_data['email']"/>
            </t>
            <t t-else="">$0</t>
        </xpath>
        <!-- Guia de medidas: va DENTRO del bucle de preguntas, justo antes de la que la pide
             (marcada con `installation_measure_guide`), para que se lea justo donde hay que
             responder. Sirve para los dos caminos: la pregunta de la medida es reutilizable y la
             comparten el tipo de cita del checkout y el del link. -->
        <xpath expr="//t[@t-foreach='appointment_type.question_ids']/div[hasclass('row')]" position="before">
            <t t-if="question.installation_measure_guide"
               t-call="website_sale_installation_appointment.installation_measure_guide"/>
        </xpath>
        <!-- Direccion de la instalacion (D58). Solo en los tipos de cita agendados FUERA del
             eCommerce (el link que comparte Nokey): ahi no hay pedido ni direccion de entrega, y
             sin esto la tarea del instalador queda sin lugar al que ir. Va ANTES del bloque de
             fotos: primero donde es, despues como es. -->
        <xpath expr="//t[@t-if='appointment_type.allow_guests']" position="before">
            <!-- `o_not_editable`: el bloque vive dentro de un `oe_structure` del core, asi que sin
                 esto sus etiquetas y placeholders se pueden editar desde el editor web — y eso crea
                 una copia por sitio que deja de recibir las actualizaciones del modulo (D42). -->
            <t t-if="installation_link_form and appointment_type._is_installation_asking_address()"
               t-call="website_sale_installation_appointment.installation_form_section">
                <t t-set="sec_num">3</t>
                <t t-set="sec_title">Installation address</t>
                <t t-set="sec_help">Enter the address where the installation will take place.</t>
            </t>
            <!-- D61: primera linea del bloque, siempre que el bloque exista (calle y localidad son
                 siempre obligatorias) — se lee con y sin secciones numeradas. -->
            <p t-if="appointment_type._is_installation_asking_address()"
               class="text-danger mb-2 o_not_editable"><i class="fa fa-exclamation-circle me-1" role="img"/>Required: street and number, and town.</p>
            <div class="row mb-4 o_not_editable" t-if="appointment_type._is_installation_asking_address()">
                <label t-attf-class="col-sm-3 col-form-label fw-normal#{' d-none' if installation_link_form else ''}"
                       for="installation_street">
                    Installation address *
                </label>
                <div class="col-sm-9">
                    <input type="text" class="form-control mb-2" id="installation_street"
                           name="installation_street" required="1" maxlength="128"
                           placeholder="Street and number, e.g. Lamadrid 581"
                           t-att-value="installation_address_data.get('street') or ''"/>
                    <input type="text" class="form-control mb-2" id="installation_street2"
                           name="installation_street2" maxlength="128"
                           placeholder="Floor / apartment (optional)"
                           t-att-value="installation_address_data.get('street2') or ''"/>
                    <div class="row g-2">
                        <div class="col-8">
                            <input type="text" class="form-control" id="installation_city"
                                   name="installation_city" required="1" maxlength="64"
                                   placeholder="Town, e.g. Tigre"
                                   t-att-value="installation_address_data.get('city') or ''"/>
                        </div>
                        <div class="col-4">
                            <input type="text" class="form-control" id="installation_zip"
                                   name="installation_zip" maxlength="16"
                                   placeholder="ZIP"
                                   t-att-value="installation_address_data.get('zip') or ''"/>
                        </div>
                    </div>
                    <input type="text" class="form-control mt-2" id="installation_between_streets"
                           name="installation_between_streets" maxlength="100"
                           placeholder="Between streets, e.g. Peru and Chile"
                           t-att-value="installation_address_data.get('between_streets') or ''"/>
                    <small class="form-text text-muted">
                        The cross streets help in areas where the street numbering is hard to follow.
                    </small>
                </div>
            </div>
        </xpath>
        <xpath expr="//t[@t-if='appointment_type.allow_guests']" position="before">
            <!-- D57: `_is_installation_asking_photos()` y no `installation_request_photos` a
                 secas. En el camino del checkout las fotos ya se piden (y se guardan) en el Paso 2
                 del paso de Instalacion: mostrar el input aca hacia que el cliente subiera las
                 mismas fotos dos veces y que solo contaran las del checkout. -->
            <t t-if="installation_link_form and appointment_type._is_installation_asking_photos()"
               t-call="website_sale_installation_appointment.installation_form_section">
                <t t-set="sec_num">4</t>
                <t t-set="sec_title">Photos of the site</t>
                <t t-set="sec_help">So the crew knows what it will find before going.</t>
            </t>
            <div class="row mb-4" t-if="appointment_type._is_installation_asking_photos()">
                <label t-attf-class="col-sm-3 col-form-label fw-normal#{' d-none' if installation_link_form else ''}"
                       for="installation_photos">
                    Photos of the site<t t-if="appointment_type.installation_min_photos"> *</t>
                </label>
                <div class="col-sm-9">
                    <!-- Misma consigna que el paso del checkout, del campo del tipo de cita: un solo
                         texto para los dos caminos, editable sin tocar la plantilla. -->
                    <t t-call="website_sale_installation_appointment.installation_photos_message"/>
                    <t t-call="website_sale_installation_appointment.installation_photo_examples"/>
                    <!-- D61: inmediatamente arriba del input, solo si el minimo es > 0 (con 0
                         las fotos son opcionales). El numero va en un `t-out` propio: el
                         catalogo lleva los dos terminos de texto por separado, alrededor de el. -->
                    <p t-if="appointment_type.installation_min_photos"
                       class="text-danger mb-2 o_not_editable"><i class="fa fa-exclamation-circle me-1" role="img"/>Required: upload at least
                        <span t-out="appointment_type.installation_min_photos"/> photo(s) to confirm the appointment.</p>
                    <input type="file" id="installation_photos" name="installation_photos"
                           class="form-control" multiple="multiple" accept="image/*"
                           t-att-required="appointment_type.installation_min_photos and '1' or None"/>
                </div>
            </div>
        </xpath>
        <xpath expr="//input[@type='phone']" position="replace">
            <t t-set="input_attrs" t-value="question._answer_input_attrs()"/>
            <input class="form-control" t-att="input_attrs"
                   t-attf-name="question_#{question.id}"
                   t-att-value="partner_data['phone'] if isMainPhoneQuestion and 'phone' in partner_data else ''"
                   t-att-required="question.question_required or None"
                   t-att-placeholder="question.placeholder"
                   t-att-data-is-main-phone-question="isMainPhoneQuestion"/>
        </xpath>
        <xpath expr="//input[@type='char' and @t-attf-name]" position="replace">
            <t t-set="input_attrs" t-value="question._answer_input_attrs()"/>
            <input class="form-control" t-att="input_attrs"
                   t-attf-name="question_#{question.id}"
                   t-att-required="question.question_required or None"
                   t-att-placeholder="question.placeholder"/>
        </xpath>
    </template>

    <!-- El "antes de agendar" tiene que leerse ANTES de elegir el turno. El core pinta
         `message_intro` al final de la pagina, bajo el titulo "Descripcion": para una instalacion
         (pilas, direccion completa, cuanto dura, como se paga) eso llega tarde. En el tipo de cita
         del link se sube arriba del calendario y se apaga el bloque de abajo para no repetirlo.
         Solo el tipo del LINK (`installation_fsm_project_id`, que es justamente el marcador de las
         instalaciones agendadas fuera del eCommerce): en la compra el checklist ya se lee en el
         paso "Instalacion" del checkout, repetirlo en la pagina del turno seria ruido.
         El bloque va FUERA de `o_appointment_info_main`, que es `o_not_editable`: asi el `t-field`
         sigue siendo editable en linea desde el editor, igual que el bloque nativo. -->
    <template id="appointment_info" inherit_id="appointment.appointment_info">
        <!-- Primero se apaga el bloque nativo del final y DESPUES se agrega el de arriba: los dos
             pintan el mismo `t-field` y el xpath resuelve por el primero que encuentra, asi que al
             reves este `attributes` caeria sobre el bloque nuevo. La clase `o_appointment_intro`
             del nativo viaja en un `t-attf-class` (es dinamica), por eso `hasclass()` no la ve y se
             ancla por el `t-field`.
             D54: se apaga en DOS casos ademas del tipo del link: tambien cuando el visitante
             viene del checkout (_is_installation_checkout_source()), porque ya lo leyo en el
             Paso 2 del acordeon. -->
        <xpath expr="//div[@t-field='appointment_type.message_intro']/.." position="attributes">
            <attribute name="t-if">not appointment_type.installation_fsm_project_id and not appointment_type._is_installation_checkout_source()</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_appointment_info_main')]" position="before">
            <div t-if="appointment_type.installation_fsm_project_id and not is_html_empty(appointment_type.message_intro)"
                 class="alert alert-light border mb-4"
                 t-field="appointment_type.message_intro"/>
        </xpath>
    </template>
</odoo>
