<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hereda el form de delivery.carrier (delivery.view_delivery_carrier_form), ya extendido por
         website_sale (delivery.carrier.website.form) que agrega website_description. Ubicamos
         nuestro campo justo despues de ese, en la misma pestana de configuracion web. -->
    <record id="delivery_carrier_view_form" model="ir.ui.view">
        <field name="name">delivery.carrier.view.form.inherit.website_sale_delivery_price_label</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <field name="website_description" position="after">
                <field
                    name="website_price_label"
                    placeholder="e.g. To be agreed"
                />
            </field>
        </field>
    </record>
</odoo>
