<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website_sale_category_boxes</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="ecommerce_access_setting" position="after">
                <setting
                    id="shop_category_boxes_setting"
                    string="Category Boxes"
                    help="Show each main category of the shop sidebar in its own box. Applies to the selected website."
                >
                    <field name="website_shop_category_boxes"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
